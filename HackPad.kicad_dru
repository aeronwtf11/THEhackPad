(version 1)
(rule "Leiterbahnen am LED-Ausschnitt"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.memberOfFootprint('D*') || B.memberOfFootprint('D*')"))
(rule "LED-Pads am eigenen Ausschnitt"
	(constraint edge_clearance (min 0mm))
	(condition "A.memberOfFootprint('D*') && B.memberOfFootprint('D*')"))
